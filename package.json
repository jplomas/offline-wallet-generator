{
  "name": "offline-wallet-generator",
  "version": "2.0.0",
  "private": true,
  "engines": { "node": ">=22" },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:offline": "vite build --mode offline",
    "check:offline": "./scripts/check-offline-artifact.sh",
    "build:verified": "npm test && npm run build && npm run build:offline && npm run check:offline",
    "serve": "vite preview",
    "test": "node --test",
    "postinstall": "cp -r node_modules/@theqrl/qrllib-browserify/dist/qrllib.js public/qrllib.js"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "6.7.2",
    "@fortawesome/free-solid-svg-icons": "6.7.2",
    "@fortawesome/vue-fontawesome": "3.0.8",
    "@theqrl/qrllib-browserify": "1.1.0",
    "buffer": "6.0.3",
    "jspdf": "2.5.2",
    "print-js": "1.6.0",
    "scrypt-js": "3.0.1",
    "vue": "3.5.26",
    "vue-router": "4.5.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.18",
    "@vitejs/plugin-vue": "6.0.3",
    "@vue/compiler-sfc": "3.5.26",
    "daisyui": "5.5.14",
    "lightningcss": "1.30.2",
    "postcss": "8.5.6",
    "tailwindcss": "4.1.18",
    "vite": "7.3.0",
    "vite-plugin-singlefile": "2.3.0"
  }
}
